{
  "name": "browser-llm-perf",
  "private": true,
  "version": "0.1.0",
  "description": "Reproducible LLM-driven browser automation benchmarks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtopuzov/browser-llm-perf.git"
  },
  "homepage": "https://github.com/dtopuzov/browser-llm-perf#readme",
  "bugs": {
    "url": "https://github.com/dtopuzov/browser-llm-perf/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "browser": "playwright cli",
    "browser:mcp": "playwright mcp --headless --isolated --browser chrome --output-mode file --codegen none",
    "skills:install": "node scripts/install-skills.mjs",
    "bench": "node scripts/benchmark.mjs",
    "bench:e2e": "node scripts/suite-benchmark.mjs --suite e2e",
    "bench:cli": "node scripts/cli-benchmark.mjs",
    "report": "node scripts/report.mjs",
    "report:suite": "node scripts/suite-report.mjs"
  },
  "devDependencies": {
    "craftdriver": "file:../craftdriver",
    "playwright": "1.62.0",
    "vibium": "26.5.31"
  }
}
